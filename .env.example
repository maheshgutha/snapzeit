# SnapZeiT Environment Variables
# Copy this file to .env and fill in your actual values

# ==========================================
# PAYMENT PROCESSING
# ==========================================
# Stripe
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
VITE_STRIPE_CONNECT_ID=ca_your_stripe_connect_id

# Optional: Other payment processors
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id
VITE_SQUARE_APPLICATION_ID=your_square_app_id

# ==========================================
# PWA & NOTIFICATIONS
# ==========================================
# Generate VAPID keys at: https://web-push-codelab.glitch.me/
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VITE_VAPID_PRIVATE_KEY=your-vapid-private-key (KEEP PRIVATE)

# ==========================================
# EMAIL SERVICE (server-side — used for password reset emails)
# Configure ONE of these. Resend (resend.com) has a simple free tier.
# ==========================================
RESEND_API_KEY=re_your_resend_key
# SENDGRID_API_KEY=SG.your-sendgrid-key
EMAIL_FROM=SnapZeiT <noreply@yourdomain.com>
# Base URL used in emailed links (your deployed site URL)
APP_URL=http://localhost:8080

# ==========================================
# MAPBOX (LOCATION SERVICES)
# ==========================================
VITE_MAPBOX_TOKEN=pk.your_mapbox_token
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v11

# ==========================================
# AI & MACHINE LEARNING
# ==========================================
# For future AI integrations
VITE_OPENAI_API_KEY=sk-your-openai-key
VITE_HUGGINGFACE_API_KEY=hf_your_huggingface_key
VITE_AWS_REGION=us-east-1
VITE_AWS_REKOGNITION_ENABLED=false

# ==========================================
# ANALYTICS & MONITORING
# ==========================================
VITE_GOOGLE_ANALYTICS_ID=G-your-ga-id
VITE_SENTRY_DSN=https://your-sentry-dsn
VITE_ENVIRONMENT=development

# ==========================================
# APPLICATION SETTINGS
# ==========================================
VITE_APP_NAME=SnapZeiT
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001
VITE_PLATFORM_COMMISSION_RATE=0.05  # 5% (client display only)
# Server-side platform fee percentage taken from each booking (0-50).
# Can also be set at runtime via platform_settings key 'commission_rate'.
PLATFORM_COMMISSION_RATE=5
VITE_DEFAULT_CURRENCY=USD

# ==========================================
# RAZORPAY (Client & Server)
# Get test keys from Razorpay dashboard and set the server secret securely
# VITE_RAZORPAY_KEY_ID is exposed to client (use test key for dev only)
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
# Server-side secret (do NOT expose this to the browser)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=rzp_test_YOUR_SECRET

# ==========================================
# MONGODB MIGRATION
# ==========================================
MONGO_URI=mongodb+srv://your_db_user:your_db_password@your-cluster.mongodb.net/?appName=Cluster0
# Keep 'snapzeit' unless you migrate data — the existing database uses this name
MONGO_DB_NAME=snapzeit

# ==========================================
# FEATURE FLAGS
# ==========================================
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_PWA=true
VITE_ENABLE_EQUIPMENT_RENTALS=true
VITE_ENABLE_STUDIO_BOOKINGS=true
VITE_ENABLE_AI_MATCHING=true
VITE_ENABLE_DEMAND_FORECASTING=true
VITE_ENABLE_BIDIRECTIONAL_REVIEWS=true
